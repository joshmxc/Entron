generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum GuestType {
  SINGLE
  DOUBLE
  FAMILY
  VIP
}

enum ScanStatus {
  SUCCESS
  ALREADY_SCANNED
  INVALID_QR
  WRONG_EVENT
  LIMIT_REACHED
}

enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum PaymentProvider {
  MPESA
  AIRTEL
  TIGO_PESA
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum MessageChannel {
  WHATSAPP
  SMS
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  language     String   @default("sw")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  scans         Scan[]
  sentMessages  OutboundMessage[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Event {
  id           String    @id @default(uuid())
  name         String
  nameSwahili  String?   @map("name_swahili")
  description  String?
  venue        String
  venueSwahili String?   @map("venue_swahili")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  bannerUrl    String?   @map("banner_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  guests   Guest[]
  scans    Scan[]
  payments Payment[]

  @@map("events")
}

model Guest {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  email         String?
  tableNumber   String?   @map("table_number")
  seatNumber    String?   @map("seat_number")
  guestType     GuestType @default(SINGLE) @map("guest_type")
  maxAdmissions Int       @default(1) @map("max_admissions")
  admissionsUsed Int      @default(0) @map("admissions_used")
  notes         String?
  qrCode        String    @unique @map("qr_code")
  qrImageUrl    String?   @map("qr_image_url")
  isCheckedIn   Boolean   @default(false) @map("is_checked_in")
  checkedInAt   DateTime? @map("checked_in_at")
  importBatchId String?   @map("import_batch_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scans       Scan[]
  invitations GuestInvitation[]
  payments    Payment[]

  @@index([eventId])
  @@index([qrCode])
  @@index([phone])
  @@map("guests")
}

model ImportBatch {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  filename   String
  rowCount   Int      @map("row_count")
  importedBy String   @map("imported_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("import_batches")
}

model Scan {
  id             String     @id @default(uuid())
  guestId        String     @map("guest_id")
  eventId        String     @map("event_id")
  staffId        String     @map("staff_id")
  status         ScanStatus
  admissionCount Int        @default(1) @map("admission_count")
  deviceInfo     String?    @map("device_info")
  syncedFromOffline Boolean @default(false) @map("synced_from_offline")
  originalTimestamp DateTime? @map("original_timestamp")
  createdAt      DateTime   @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff User  @relation(fields: [staffId], references: [id])

  @@index([eventId, createdAt])
  @@index([staffId])
  @@index([guestId])
  @@map("scans")
}

model InvitationTemplate {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  name      String
  fileUrl   String     @map("file_url")
  fields    Json
  cardType  GuestType? @map("card_type")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  invitations GuestInvitation[]

  @@map("invitation_templates")
}

model GuestInvitation {
  id           String           @id @default(uuid())
  guestId      String           @map("guest_id")
  templateId   String           @map("template_id")
  cardUrl      String?          @map("card_url")
  channel      MessageChannel   @default(WHATSAPP)
  status       InvitationStatus @default(PENDING)
  sentAt       DateTime?        @map("sent_at")
  deliveredAt  DateTime?        @map("delivered_at")
  readAt       DateTime?        @map("read_at")
  messageId    String?          @map("message_id")
  errorMessage String?          @map("error_message")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  guest    Guest              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  template InvitationTemplate @relation(fields: [templateId], references: [id])

  @@index([guestId])
  @@index([status])
  @@map("guest_invitations")
}

model OutboundMessage {
  id         String           @id @default(uuid())
  sentBy     String           @map("sent_by")
  phone      String
  body       String
  channel    MessageChannel   @default(WHATSAPP)
  externalId String?          @map("external_id")
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  sender User @relation(fields: [sentBy], references: [id])

  @@index([phone])
  @@map("outbound_messages")
}

model Payment {
  id              String          @id @default(uuid())
  eventId         String          @map("event_id")
  guestId         String?         @map("guest_id")
  phone           String
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("TZS")
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  externalRef     String?         @map("external_ref")
  providerRef     String?         @map("provider_ref")
  callbackPayload Json?           @map("callback_payload")
  description     String?
  initiatedBy     String?         @map("initiated_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  event Event  @relation(fields: [eventId], references: [id])
  guest Guest? @relation(fields: [guestId], references: [id])

  @@index([eventId])
  @@index([externalRef])
  @@map("payments")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OfflineSyncLog {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  userId    String   @map("user_id")
  synced    Int
  errors    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("offline_sync_logs")
}
